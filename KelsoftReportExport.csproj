<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Bitness is decided by the publish profile's RuntimeIdentifier, because the app
         must match the bitness of the installed ACE OLEDB provider: win-x64 for 64-bit
         Office, win-x86 for 32-bit. Left unset here so both can be produced. -->
    <AssemblyName>KelsoftReportExport</AssemblyName>
    <RootNamespace>KelsoftReportExport</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Declares per-monitor v2 DPI awareness rather than relying on the runtime default. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded so the window and taskbar can use it at runtime. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>
