<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== palette ===================== -->

    <SolidColorBrush x:Key="Page"          Color="#F4F6FA" />
    <SolidColorBrush x:Key="Card"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderSoft"    Color="#E4E8EF" />
    <SolidColorBrush x:Key="BorderStrong"  Color="#C3CAD6" />
    <SolidColorBrush x:Key="TextPrimary"   Color="#101828" />
    <SolidColorBrush x:Key="TextMuted"     Color="#667085" />
    <SolidColorBrush x:Key="TextFaint"     Color="#98A2B3" />

    <SolidColorBrush x:Key="Accent"        Color="#2F6FED" />
    <SolidColorBrush x:Key="AccentHover"   Color="#2560D8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1E4FB8" />
    <SolidColorBrush x:Key="AccentTint"    Color="#EEF4FF" />

    <SolidColorBrush x:Key="Success"       Color="#067647" />
    <SolidColorBrush x:Key="SuccessTint"   Color="#ECFDF3" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#ABEFC6" />

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#1E3A5F" />
        <GradientStop Offset="0.55" Color="#16304F" />
        <GradientStop Offset="1"   Color="#0E2038" />
    </LinearGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===================== compact layout ===================== -->

    <!--
      Every measurement that has to give way on a small or heavily scaled display is gathered
      here: the setter carries the roomy value, the trigger the tight one. The window raises
      IsCompact once it is too small for the roomy spacing — chiefly a display-scaling matter,
      since at 150% a 1080p desktop is only about 690 units tall. Keeping the two values side
      by side means the difference between the layouts reads in one place rather than having
      to be hunted through the window.
    -->

    <Style x:Key="HeaderBlock" TargetType="Grid">
        <Setter Property="Margin" Value="30,6,30,26" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Margin" Value="20,2,20,14" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppLogo" TargetType="Border">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="#26456C" />
        <Setter Property="Margin" Value="0,2,18,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Margin" Value="0,0,13,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppLogoGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="#8FB6E8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="FontSize" Value="17" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BodyCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Margin" Value="24,20,24,16" />
        <Setter Property="Padding" Value="26,22" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#101828" BlurRadius="18" ShadowDepth="2"
                                  Direction="270" Opacity="0.07" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Margin" Value="12,10,12,8" />
                <Setter Property="Padding" Value="16,14" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
      A step heading is a StackPanel, or a Grid where the step carries buttons beside it, so
      these target the base type the two share: a keyed style may be applied to any element
      its target type is assignable from.
    -->
    <Style x:Key="FirstStepHeading" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Margin" Value="0,0,0,7" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StepHeading" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,26,0,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Margin" Value="0,15,0,7" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The part of the body that gives up height first, because it scrolls internally. -->
    <Style x:Key="YearsShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinHeight" Value="210" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="112" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ActionBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="30,16" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Padding" Value="18,10" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== text ===================== -->

    <Style x:Key="AppTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="FontSize" Value="17" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Explanatory rather than load-bearing, so it is the first thing dropped when short. -->
    <Style x:Key="AppSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#A9BEDC" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StepLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- Numbered step badge -->
    <Style x:Key="StepNumber" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource AccentTint}" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StepNumberText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== input fields ===================== -->

    <Style x:Key="FieldShell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="FieldIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <Style x:Key="PlainTextBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== checkbox ===================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- Brushes are declared per instance rather than shared from the
                             palette, so each box can animate its own colour. -->
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                BorderThickness="1.5" VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#C3CAD6" />
                            </Border.BorderBrush>
                            <Path x:Name="Tick" Opacity="0"
                                  Data="M 0,3.6 L 3.2,6.8 L 8.4,0.8"
                                  Stroke="White" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#2F6FED" Duration="0:0:0.14" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#2F6FED" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#FFFFFF" Duration="0:0:0.14" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#C3CAD6" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.4" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.4" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== report selection card ===================== -->

    <Style x:Key="ReportCard" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5"
                            Padding="16,14" SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="#FFFFFF" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#E4E8EF" />
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="18" Height="18"
                                    CornerRadius="5" BorderThickness="1.5"
                                    VerticalAlignment="Top" Margin="0,1,12,0">
                                <Border.Background>
                                    <SolidColorBrush Color="#FFFFFF" />
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#C3CAD6" />
                                </Border.BorderBrush>
                                <Path x:Name="Tick" Opacity="0"
                                      Data="M 0,3.6 L 3.2,6.8 L 8.4,0.8"
                                      Stroke="White" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#EEF4FF" Duration="0:0:0.20" />
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#2F6FED" Duration="0:0:0.20" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#2F6FED" Duration="0:0:0.14" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#2F6FED" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="1" Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#FFFFFF" Duration="0:0:0.20" />
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#E4E8EF" Duration="0:0:0.20" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#FFFFFF" Duration="0:0:0.14" />
                                        <ColorAnimation Storyboard.TargetName="Box"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#C3CAD6" Duration="0:0:0.14" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         To="0.4" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Tick"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         To="0.4" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#C3CAD6" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Card"
                                                        Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="#E4E8EF" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="Card" Property="Padding" Value="11,9" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReportCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="ReportCardDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== buttons ===================== -->

    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="30,11" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#2F6FED" BlurRadius="14" ShadowDepth="3"
                                  Direction="270" Opacity="0.30" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Padding" Value="20,9" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== caption buttons ===================== -->

    <!-- The standard frame is replaced by WindowChrome, so the window supplies its own. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CBDAEE" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#25FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#3AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="29" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#C50F1F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== year list ===================== -->

    <Style x:Key="YearRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="6" Opacity="0"
                            Padding="{TemplateBinding Padding}" Margin="0,1">
                        <Border.Background>
                            <SolidColorBrush Color="Transparent" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform Y="10" />
                        </Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Rows rise into place as the file's years are listed. Containers are
                             generated in order, so this reads as a stagger without scheduling one. -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Row"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.26" />
                                    <DoubleAnimation Storyboard.TargetName="Row"
                                                     Storyboard.TargetProperty="RenderTransform.Y"
                                                     To="0" Duration="0:0:0.30">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Row"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="#F4F6FA" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Row"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="Transparent" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Entry-count pill -->
    <Style x:Key="CountPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Background" Value="{StaticResource Page}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CountPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <!-- ===================== misc ===================== -->

    <Style x:Key="ClientChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Background" Value="{StaticResource SuccessTint}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SlimProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

</ResourceDictionary>
