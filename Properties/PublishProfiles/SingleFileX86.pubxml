<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained 32-bit .exe, for machines with 32-bit Office / Access.

  Publish with:  dotnet publish -p:PublishProfile=SingleFile

  Notes:
   - SelfContained bundles the .NET runtime, so the target machine needs no .NET install.
   - IncludeNativeLibrariesForSelfExtract is required for WPF: its native libraries
     (wpfgfx, PresentationNative) cannot be loaded straight from the bundle, so they are
     extracted to a temp folder on first run.
   - PublishTrimmed is deliberately absent — trimming is unsupported for WPF and silently
     breaks XAML-driven reflection.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>publish-single-x86</PublishDir>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
