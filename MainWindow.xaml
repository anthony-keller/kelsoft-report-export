<Window x:Class="KelsoftReportExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelsoft Report Export"
        Width="980" Height="910" MinWidth="820" MinHeight="740"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Page}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="30,24,30,26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                        Background="#26456C" Margin="0,2,18,0">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9D2;"
                               FontSize="22" Foreground="#8FB6E8"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Kelsoft Report Export" Style="{StaticResource AppTitle}" />
                    <TextBlock Style="{StaticResource AppSubtitle}"
                               Text="Monthly Profit and Loss and Balance Sheet statements, straight from a Kelsoft client data file to Excel." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ body ============ -->
        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                Margin="24,20,24,16" Padding="26,22">
            <Border.Effect>
                <DropShadowEffect Color="#101828" BlurRadius="18" ShadowDepth="2"
                                  Direction="270" Opacity="0.07" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. data file -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="1" Style="{StaticResource StepNumberText}" />
                    </Border>
                    <TextBlock Text="Kelsoft data file" Style="{StaticResource StepLabel}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FieldShell}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldIcon}" Text="&#xE8A5;" />
                            <TextBox x:Name="DataFileBox" Grid.Column="1" IsReadOnly="True"
                                     Style="{StaticResource PlainTextBox}" />
                        </Grid>
                    </Border>
                    <Button x:Name="BrowseDataButton" Grid.Column="1" Content="Browse…"
                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Click="BrowseData_Click" />
                </Grid>

                <Border x:Name="ClientChipPanel" Grid.Row="2" Style="{StaticResource ClientChip}"
                        Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="13"
                                   Foreground="{StaticResource Success}" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock x:Name="ClientLabel" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Success}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 2. reports -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,26,0,10">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="2" Style="{StaticResource StepNumberText}" />
                    </Border>
                    <TextBlock Text="Reports to produce" Style="{StaticResource StepLabel}" />
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton x:Name="ProfitAndLossCheck" Grid.Column="0" IsChecked="True"
                                  Style="{StaticResource ReportCard}" Margin="0,0,7,0"
                                  Checked="ReportChoice_Changed" Unchecked="ReportChoice_Changed">
                        <StackPanel>
                            <TextBlock Text="Profit and Loss Statement" Style="{StaticResource ReportCardTitle}" />
                            <TextBlock Style="{StaticResource ReportCardDetail}"
                                       Text="Trading income through to net profit — twelve monthly columns plus a year total." />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="BalanceSheetCheck" Grid.Column="1" IsChecked="True"
                                  Style="{StaticResource ReportCard}" Margin="7,0,0,0"
                                  Checked="ReportChoice_Changed" Unchecked="ReportChoice_Changed">
                        <StackPanel>
                            <TextBlock Text="Balance Sheet" Style="{StaticResource ReportCardTitle}" />
                            <TextBlock Style="{StaticResource ReportCardDetail}"
                                       Text="Owners equity against assets and liabilities, as at each month end." />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- 3. years -->
                <Grid Grid.Row="5" Margin="0,26,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="3" Style="{StaticResource StepNumberText}" />
                        </Border>
                        <TextBlock Text="Financial years" Style="{StaticResource StepLabel}" />
                        <TextBlock x:Name="YearSummary" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" Margin="10,1,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Select all" Style="{StaticResource LinkButton}"
                            Click="SelectAll_Click" />
                    <Button Grid.Column="2" Content="Select none" Style="{StaticResource LinkButton}"
                            Click="SelectNone_Click" />
                </Grid>

                <Border Grid.Row="6" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                        CornerRadius="9" Padding="5" MinHeight="210" Background="White">
                    <Grid>
                        <ListBox x:Name="YearsList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource YearRow}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                   Width="74" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Period}"
                                                   Foreground="{StaticResource TextMuted}" FontSize="12.5"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Style="{StaticResource CountPill}">
                                            <TextBlock Text="{Binding EntryText}"
                                                       Style="{StaticResource CountPillText}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyYears" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="Choose a data file to list its financial years." />
                    </Grid>
                </Border>

                <!-- 4. output -->
                <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,26,0,10">
                    <Border Style="{StaticResource StepNumber}">
                        <TextBlock Text="4" Style="{StaticResource StepNumberText}" />
                    </Border>
                    <TextBlock Text="Save Excel file to" Style="{StaticResource StepLabel}" />
                </StackPanel>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FieldShell}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldIcon}" Text="&#xE9F9;" />
                            <TextBox x:Name="OutputBox" Grid.Column="1"
                                     Style="{StaticResource PlainTextBox}" />
                        </Grid>
                    </Border>
                    <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="Browse…"
                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Click="BrowseOutput_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ action bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource Card}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
                Padding="30,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="OpenWhenDone" Grid.Column="0" Content="Open when finished"
                          IsChecked="True" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,24,0">
                    <TextBlock x:Name="StatusLabel" Style="{StaticResource Hint}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}"
                                 Margin="0,7,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="ExportButton" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Export_Click"
                        AutomationProperties.Name="Export">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE898;" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Export" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
