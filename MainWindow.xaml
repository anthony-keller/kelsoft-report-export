<Window x:Class="KelsoftReportExport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelsoft — Monthly Report Export"
        Width="940" Height="760" MinWidth="780" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,18">
            <TextBlock Text="Monthly Report Export" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Subheading}"
                       Text="Reads a Kelsoft client data file and writes an Excel workbook with a worksheet per financial year, broken down by month." />
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="28,0,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Kelsoft data file" Style="{StaticResource FieldLabel}" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DataFileBox" Grid.Column="0" IsReadOnly="True"
                         Foreground="{StaticResource TextPrimary}" />
                <Button x:Name="BrowseDataButton" Grid.Column="1" Content="Browse…"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="BrowseData_Click" />
            </Grid>

            <TextBlock x:Name="ClientLabel" Grid.Row="2" Margin="2,8,0,0"
                       Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="3" Text="Reports to produce" Style="{StaticResource FieldLabel}"
                       Margin="0,20,0,6" />

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <CheckBox x:Name="ProfitAndLossCheck" Content="Profit and Loss Statement"
                          IsChecked="True" Margin="2,0,28,0" Checked="ReportChoice_Changed"
                          Unchecked="ReportChoice_Changed" />
                <CheckBox x:Name="BalanceSheetCheck" Content="Balance Sheet"
                          IsChecked="True" Checked="ReportChoice_Changed"
                          Unchecked="ReportChoice_Changed" />
            </StackPanel>

            <Grid Grid.Row="5" Margin="0,22,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Financial years to include"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                           Margin="0,0,0,0" />
                <Button Grid.Column="1" Content="Select all" Style="{StaticResource LinkButton}"
                        Click="SelectAll_Click" />
                <Button Grid.Column="2" Content="Select none" Style="{StaticResource LinkButton}"
                        Click="SelectNone_Click" />
            </Grid>

            <Border Grid.Row="6" BorderBrush="{StaticResource BorderGrey}" BorderThickness="1"
                    CornerRadius="6" Padding="4" MinHeight="150">
                <ListBox x:Name="YearsList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource YearItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Content="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="7" Text="Save Excel file to" Style="{StaticResource FieldLabel}"
                       Margin="0,20,0,6" />

            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputBox" Grid.Column="0" />
                <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="Browse…"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        Click="BrowseOutput_Click" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderGrey}" />

        <!-- Action bar -->
        <Grid Grid.Row="3" Background="{StaticResource Surface}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="OpenWhenDone" Grid.Column="0" Content="Open when finished"
                      IsChecked="True" VerticalAlignment="Center" Margin="28,18,20,18" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,18,20,18">
                <TextBlock x:Name="StatusLabel" Foreground="{StaticResource TextMuted}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0"
                             IsIndeterminate="True" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Accent}" />
            </StackPanel>

            <Button x:Name="ExportButton" Grid.Column="2" Content="Export"
                    Style="{StaticResource PrimaryButton}" Margin="0,18,28,18"
                    IsDefault="True" Click="Export_Click" />
        </Grid>
    </Grid>
</Window>
